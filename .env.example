# ==============================================================================
# TakeMe - Configurare Mediu (Node.js + PostgreSQL)
# ==============================================================================

# Conexiune PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=takeme_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# URL complet conexiune (utilizat de pg în Node.js)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takeme_db"

# Port Server Backend Node.js
PORT=3000

# JWT Secret pentru /auth
JWT_SECRET="takeme_iasi_hackathon_super_secret_key_2026"
