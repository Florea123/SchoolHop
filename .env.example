# ==============================================================================
# SchoolHop - Configurare mediu (Node.js + PostgreSQL)
# Copiază fișierul în .env și modifică valorile după nevoie.
# ==============================================================================

# Conexiune PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=takeme_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# URL complet conexiune (utilizat de pg în Node.js)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takeme_db"

# Server HTTP (API + frontend)
PORT=3000

# Secret pentru semnarea token-urilor JWT (schimbă-l în producție!)
JWT_SECRET="schimba_acest_secret_in_productie"
JWT_EXPIRES_IN=7d

# Fusul orar folosit pentru zilele de școală și orele curselor
APP_TIMEZONE=Europe/Bucharest

# Butoanele de simulare a deplasării mașinii (pentru demo fără GPS real)
ALLOW_SIMULATION=true

# Distanța (metri) față de traseu peste care se declanșează alerta de deviere
DEVIATION_THRESHOLD_M=600

# Cât dublează sponsorul pentru fiecare leu donat în Fondul Social (0 = fără dublare)
SPONSOR_MATCH_RATIO=1

# Cheia API pentru modelul AI al asistentului pentru părinți (de completat)
AI_API_KEY=
